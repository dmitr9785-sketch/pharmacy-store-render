<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Админ-панель</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container">
    <div class="admin-header">
      <h1>Управление товарами</h1>
      <a href="/admin/products/new" class="btn">+ Добавить товар</a>
    </div>
    <table class="admin-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Фото</th>
          <th>Название</th>
          <th>Категория</th>
          <th>Цена</th>
          <th>Рецепт</th>
          <th>Остаток</th>
          <th>Действия</th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach(p => { %>
          <tr>
            <td><%= p.id %></td>
            <td><img src="/uploads/<%= p.imageUrl || p.image %>" class="admin-thumb"></td>
            <td><%= p.name %></td>
            <td><%= p.Category ? p.Category.name : '-' %></td>
            <td><%= p.price %> ₽</td>
            <td><%= p.requiresPrescription ? 'Да' : 'Нет' %></td>
            <td><%= p.stock %></td>
            <td>
              <a href="/admin/products/<%= p.id %>/edit" class="btn btn-small">✏️</a>
              <form action="/admin/products/<%= p.id %>/delete" method="POST" style="display:inline">
                <button type="submit" class="btn btn-small btn-danger" onclick="return confirm('Удалить?')">🗑</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
