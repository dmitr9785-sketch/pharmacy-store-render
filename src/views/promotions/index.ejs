<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Аптека</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container">
    <h1>Акции и скидки</h1>
    <div class="promotions-grid">
      <% promotions.forEach(p => { %>
        <div class="promotion-card">
          <div class="promotion-badge"><%= p.badgeText %></div>
          <h3><%= p.title %></h3>
          <p><%= p.description %></p>
          <% if (p.requirements) { %>
            <p class="promotion-requirements"><%= p.requirements %></p>
          <% } %>
          <% if (p.requiresPromoCode && p.promoCode) { %>
            <div class="promo-code-box">
              <span>Промокод: <strong><%= p.promoCode %></strong></span>
              <button class="btn-copy" onclick="navigator.clipboard.writeText('<%= p.promoCode %>').then(() => this.textContent='Скопировано!').catch(() => {})">Копировать</button>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
