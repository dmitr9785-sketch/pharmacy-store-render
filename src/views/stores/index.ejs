<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Аптека</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <style>
    html, body { height: 100%; margin: 0; }
    .stores-page { display: flex; flex-direction: column; height: 100%; }
    .stores-page main { flex: 1; padding: 0; display: flex; flex-direction: column; }
    #map { flex: 1; width: 100%; border: none; }
  </style>
</head>
<body class="stores-page">
  <%- include('../partials/header') %>

  <main>
    <div id="map"></div>
  </main>

  <%- include('../partials/footer') %>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    // Безопасный способ передачи данных из Node.js без ошибок с символами '&' или кавычками
    const stores = JSON.parse(decodeURIComponent('<%= encodeURIComponent(JSON.stringify(stores)) %>'));

    const map = L.map('map').setView([55.7879, 49.1233], 11);

    // Подгружаем бесплатную подложку карт OpenStreetMap
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    if (stores && stores.length > 0) {
      const markers = [];

      stores.forEach(store => {
        const lat = parseFloat(store.lat);
        const lng = parseFloat(store.lng);

        if (!isNaN(lat) && !isNaN(lng)) {
          const marker = L.marker([lat, lng])
            .addTo(map)
            .bindPopup(`<b>${store.name}</b><br>${store.address || ''}`);
          
          markers.push(marker);
        }
      });

      // Если маркеры добавились, автоматически масштабируем карту под них
      if (markers.length > 0) {
        const group = new L.featureGroup(markers);
        map.fitBounds(group.getBounds().pad(0.1));
      }
    }

    // Лечит баг с серыми квадратами при первой загрузке карты Leaflet
    setTimeout(() => { map.invalidateSize(); }, 200);
  </script>
</body>
</html>